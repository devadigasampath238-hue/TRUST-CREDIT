# Copy this file to ".env" (or set these as real environment variables on
# your hosting platform) and fill in real values before going live.
# NEVER commit your real .env file to GitHub - keep secrets out of git.

# Random secret string used to sign login sessions. Generate one with:
#   python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=ef396cadabcf510bf8ce72d100a52af3

# Admin login username (can be anything you like)
ADMIN_USERNAME=admin

# Admin login password HASH - generate this by running:
#   python hash_password.py
# then paste the output below. Do NOT put your real password here directly.
ADMIN_PASSWORD_HASH="scrypt:32768:8:1$TSLiglkWTeGkRfz8$f22925f25c7443e6be064f4b0e2f731de47188d84bb2f0011344489e152dd8d774a4f7d902425c8f9604b6b8a4d1202a4b14668d74d8bc1133ce359c91b7e321")

# Set to "production" once this is deployed on a live server with HTTPS.
# Keep this unset (or "development") while testing locally.
FLASK_ENV=production

# Restrict which website is allowed to call your API.
# Example: https://www.trustcredit.com
ALLOWED_ORIGIN=https://trustcredit.netlify.app
